# --- Server ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
REVOLUT_SECRET_KEY=
REVOLUT_API_URL=https://sandbox-merchant.revolut.com
REVOLUT_WEBHOOK_SECRET=

# --- Client (Vite) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_REVOLUT_MODE=sandbox

# --- Auth & payments notes (see docs/SETUP_AUTH_PAYMENTS.md) ---
# SUPABASE_SERVICE_ROLE_KEY is SECRET: server only, never prefix with VITE_.
# REVOLUT_API_URL: https://sandbox-merchant.revolut.com (sandbox) | https://merchant.revolut.com (production)
# VITE_REVOLUT_MODE: sandbox | prod  (must match REVOLUT_API_URL)
# REVOLUT_WEBHOOK_SECRET: the `signing_secret` (wsk_...) returned when you register the webhook.
